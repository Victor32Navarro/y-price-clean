# Zkopíruj do .env.local pro lokální vývoj (vercel env pull .env.local
# stáhne skutečné hodnoty z projektu na Vercelu).

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Firecrawl — https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# Ochrana /api/cron proti spuštění kýmkoli zvenčí (Vercel ho posílá
# automaticky jako Authorization: Bearer <hodnota>)
CRON_SECRET=

# Upstash Redis (Vercel Dashboard → Storage → Marketplace → Upstash)
# — tyhle dvě proměnné se po propojení databáze s projektem přidají samy.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
